{
  "name": "bdf-ciq-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "preview": "vite preview --port 5310",
    "build:portal": "tsc -b && vite build -c vite.portal.config.ts && node scripts/zip-portal.mjs",
    "dev:portal": "vite -c vite.portal.config.ts --port 5320 --open /portal.html",
    "gen:workbench": "node scripts/gen-workbench-schema.mjs",
    "typecheck:workbench": "tsc -p tsconfig.workbench.json",
    "test:workbench": "vitest run -c vitest.workbench.config.ts",
    "build:workbench": "node scripts/gen-workbench-schema.mjs --check && tsc -p tsconfig.workbench.json && vite build -c vite.workbench.config.ts && node scripts/zip-workbench.mjs",
    "dev:workbench": "vite -c vite.workbench.config.ts --port 5330 --open /workbench.html",
    "harness:workbench": "node scripts/harness-workbench.mjs",
    "build:call": "tsc -b && vite build -c vite.call.config.ts && node scripts/artifact-call.mjs",
    "harness:prototype": "node scripts/harness-prototype.mjs",
    "dev:applive": "vite -c vite.applive.config.ts --port 5340 --open /app-live.html",
    "build:applive": "tsc -b && vite build -c vite.applive.config.ts && node scripts/zip-applive.mjs",
    "test:applive": "vitest run src/app-live",
    "test:live": "vitest run --config vitest.live.config.ts",
    "harness:applive": "node scripts/harness-applive.mjs",
    "gate:applive": "npm run typecheck && npm test && npm run build:applive && npm run harness:applive"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@kissflow/lowcode-client-sdk": "1.0.49",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^6.30.6",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^5.4.21",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.1.9"
  }
}
