{
 "info": {
  "name": "CIQ prod test: portal user in a request's user field",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
  "description": "Fill host, account_id, the SERVICE ACCOUNT's access key (the user I-1's connection acts as), user_id (one contact's portal user id, e.g. UsEKGUxWj18y) and user_name. Run 1 to 4D in order. Each 3x creates a DRAFT CIQP Request (never submitted) with the user written one way and 4x deletes it. Send me the Console lines (SHAPE A..D ACCEPTED/REFUSED, the user kind), never the key."
 },
 "variable": [
  {
   "key": "host",
   "value": "beiersdorf.kissflow.eu"
  },
  {
   "key": "account_id",
   "value": ""
  },
  {
   "key": "access_key_id",
   "value": ""
  },
  {
   "key": "access_key_secret",
   "value": ""
  },
  {
   "key": "model_id",
   "value": ""
  },
  {
   "key": "user_id",
   "value": "UsEKGUxWj18y"
  },
  {
   "key": "user_name",
   "value": "12343 Thomas"
  },
  {
   "key": "user_obj",
   "value": ""
  },
  {
   "key": "draft_A",
   "value": ""
  },
  {
   "key": "draft_B",
   "value": ""
  },
  {
   "key": "draft_C",
   "value": ""
  },
  {
   "key": "draft_D",
   "value": ""
  }
 ],
 "item": [
  {
   "name": "1 portal: model id",
   "request": {
    "method": "GET",
    "header": [
     {
      "key": "X-Access-Key-Id",
      "value": "{{access_key_id}}"
     },
     {
      "key": "X-Access-Key-Secret",
      "value": "{{access_key_secret}}"
     },
     {
      "key": "Content-Type",
      "value": "application/json"
     }
    ],
    "url": "https://{{host}}/portal/2/{{account_id}}/CIQ_Supplier_Portal_A00"
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "const b = pm.response.json(); console.log(\"portal answer keys:\", Object.keys(b).join(\", \"));",
       "const found = []; const walk = (o, p) => { for (const [k, v] of Object.entries(o || {})) { if (v && typeof v === \"object\") walk(v, p + k + \".\"); else if (/model/i.test(k)) found.push([p + k, v]); } }; walk(b, \"\");",
       "console.log(\"model-like keys:\", JSON.stringify(found));",
       "if (found.length && !pm.collectionVariables.get(\"model_id\")) pm.collectionVariables.set(\"model_id\", String(found[0][1]));"
      ]
     }
    }
   ]
  },
  {
   "name": "2 portal user details",
   "request": {
    "method": "GET",
    "header": [
     {
      "key": "X-Access-Key-Id",
      "value": "{{access_key_id}}"
     },
     {
      "key": "X-Access-Key-Secret",
      "value": "{{access_key_secret}}"
     },
     {
      "key": "Content-Type",
      "value": "application/json"
     }
    ],
    "url": "https://{{host}}/user/2/{{account_id}}/portal/CIQ_Supplier_Portal_A00/{{model_id}}/{{user_id}}"
   },
   "event": [
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "console.log(\"portal user:\", pm.response.code, pm.response.text().replace(/[\\w.+-]+@[\\w.-]+/g, \"<email>\").slice(0, 600));",
       "if (pm.response.code === 200) { const u = pm.response.json(); pm.collectionVariables.set(\"user_obj\", JSON.stringify({ _id: u._id, Name: u.Name, Kind: u.Kind })); console.log(\"user kind:\", u.Kind); }"
      ]
     }
    }
   ]
  },
  {
   "name": "3A create a draft: A only _id (what I-1 sends today)",
   "request": {
    "method": "POST",
    "header": [
     {
      "key": "X-Access-Key-Id",
      "value": "{{access_key_id}}"
     },
     {
      "key": "X-Access-Key-Secret",
      "value": "{{access_key_secret}}"
     },
     {
      "key": "Content-Type",
      "value": "application/json"
     }
    ],
    "url": "https://{{host}}/process/2/{{account_id}}/CIQP_Request_A00?_application_id=CIQ_Supplier_Portal_A00",
    "body": {
     "mode": "raw",
     "raw": "{\"Request_Key\": \"ZZT-USERFIELD-A|1\", \"Case_Code\": \"ZZT-USERFIELD-A\", \"Assigned_Contacts\": [{\"_id\": \"{{user_id}}\"}], \"Release_Contacts\": [{\"_id\": \"{{user_id}}\"}]}",
     "options": {
      "raw": {
       "language": "json"
      }
     }
    }
   },
   "event": [
    {
     "listen": "prerequest",
     "script": {
      "type": "text/javascript",
      "exec": [
       "if (false) { console.log(\"skipped: step 2 gave no user object\"); pm.execution.skipRequest(); }"
      ]
     }
    },
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "const ok = pm.response.code >= 200 && pm.response.code < 300;",
       "let id = \"\"; try { id = pm.response.json()._id || \"\"; } catch (e) {}",
       "pm.collectionVariables.set(\"draft_A\", ok ? id : \"\");",
       "console.log(\"SHAPE A: \" + (ok ? \"ACCEPTED\" : \"REFUSED\") + \" (\" + pm.response.code + \") \" + (ok ? \"draft \" + id : pm.response.text().slice(0, 220)));"
      ]
     }
    }
   ]
  },
  {
   "name": "4A delete that draft",
   "request": {
    "method": "DELETE",
    "header": [
     {
      "key": "X-Access-Key-Id",
      "value": "{{access_key_id}}"
     },
     {
      "key": "X-Access-Key-Secret",
      "value": "{{access_key_secret}}"
     },
     {
      "key": "Content-Type",
      "value": "application/json"
     }
    ],
    "url": "https://{{host}}/process/2/{{account_id}}/admin/CIQP_Request_A00/{{draft_A}}?_application_id=CIQ_Supplier_Portal_A00"
   },
   "event": [
    {
     "listen": "prerequest",
     "script": {
      "type": "text/javascript",
      "exec": [
       "if (!pm.collectionVariables.get(\"draft_A\")) { pm.execution.skipRequest(); }"
      ]
     }
    },
    {
     "listen": "test",
     "script": {
      "type": "text/javascript",
      "exec": [
       "console.log(\"draft deleted:\", pm.response.code);"
      ]
     }
    }
   ]
  },
