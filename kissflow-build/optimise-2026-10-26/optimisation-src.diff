+const endedReads = new WeakMap<AppClient, Map<string, KeptFull>>();
+const endedFor = (client: AppClient): Map<string, KeptFull> => {
+  let m = endedReads.get(client);
+  if (!m) endedReads.set(client, (m = new Map()));
+  return m;
+};
+/** Each case's history signature: how many history rows name it, and the newest Event_At and _modified_at among them. */
