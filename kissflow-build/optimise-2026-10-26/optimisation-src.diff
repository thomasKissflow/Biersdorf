+  const by = new Map<string, { n: number; at: string; mod: string }>();
+  for (const r of audit) {
+    const c = str(r, "Case_Item_Id");
+    if (!c) continue;
+    const cur = by.get(c) ?? { n: 0, at: "", mod: "" };
+    cur.n++;
+    if (str(r, "Event_At") > cur.at) cur.at = str(r, "Event_At");
+    if (str(r, "_modified_at") > cur.mod) cur.mod = str(r, "_modified_at");
+    by.set(c, cur);
+  }
+  return new Map([...by].map(([c, v]) => [c, `${v.n}|${v.at}|${v.mod}`]));
