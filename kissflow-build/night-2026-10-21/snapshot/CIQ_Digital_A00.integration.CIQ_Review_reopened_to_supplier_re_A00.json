  "FieldMapping_o4ymqk": {
   "Id": "FieldMapping_o4ymqk",
   "Kind": "FieldMapping",
   "Type": "Code",
   "FieldId": "JSCode",
   "Label": "JavaScript code",
   "Name": "js_code",
   "IsRequired": true,
   "IsDropdown": false,
   "IsPaginated": false,
   "AutoRefresh": false,
   "CodeLanguage": "javascript",
